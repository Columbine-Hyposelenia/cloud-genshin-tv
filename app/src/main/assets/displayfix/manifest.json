{
  "manifest_version": 2,
  "name": "Display Fix",
  "version": "1.0",
  "description": "Runtime brightness compensation for the cloud game video surface.",
  "applications": {
    "gecko": {
      "id": "displayfix@cloudgenshin.tv"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ys.mihoyo.com/*",
        "https://*.mihoyo.com/*",
        "https://*.mihyocdn.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
